{
  "expo": {
    "name": "unamas",
    "slug": "unamas",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "unamas",
    "userInterfaceStyle": "dark",
    "ios": {
      "icon": "./assets/expo.icon",
      "bundleIdentifier": "com.jasoncito.unamas",
      "appleTeamId": "95S8WDTXCF"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#100E11",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.jasoncito.unamas"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#100E11",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      "expo-sqlite",
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "unamas usa el micrófono para que dictes tus series en vez de escribirlas.",
          "speechRecognitionPermission": "unamas convierte lo que dictas en texto para anotar tus series.",
          "androidSpeechServicePackages": [
            "com.google.android.googlequicksearchbox"
          ]
        }
      ],
      "expo-localization",
      [
        "expo-image-picker",
        {
          "cameraPermission": "unamas usa la cámara para que fotografíes una máquina que no sabes nombrar.",
          "photosPermission": "unamas abre tus fotos para que elijas la foto de una máquina.",
          "microphonePermission": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "backgroundColor": "#100E11"
  }
}
